# Copy this file to application-local.properties and set the environment variables below.
# Never commit application-local.properties.
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/ecommerce}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
jwt.secret=${JWT_SECRET}
# Tomcat native forwarding trusts configured internal proxy ranges only.
server.forward-headers-strategy=${SERVER_FORWARD_HEADERS_STRATEGY:native}
spring.datasource.password=${DB_PASSWORD}
